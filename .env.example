# ---------------------------------------------------------------------------
# Assistant de réunions — exemple de configuration.
# Copiez ce fichier en « .env » puis renseignez les valeurs.
# Ce fichier ne doit JAMAIS contenir de secret réel ni être versionné rempli.
# ---------------------------------------------------------------------------

# === Serveur local =========================================================
# L'application est conçue pour tourner sur votre poste. 127.0.0.1 garantit
# qu'elle n'est joignable que depuis cette machine. Ne mettez 0.0.0.0 que si
# vous savez ce que vous faites, et définissez alors AUTH_TOKEN.
# Le microphone n'est accessible qu'en 127.0.0.1/localhost ou en HTTPS.
HOST=127.0.0.1
PORT=8420

# Répertoire de stockage des réunions (audio, transcriptions, documents).
# Tout reste sur ce disque. Un chemin absolu est accepté.
DATA_DIR=./data

# Jeton partagé exigé dans l'en-tête « X-Auth-Token ». Vide = pas
# d'authentification, ce qui n'est acceptable qu'en écoute sur 127.0.0.1.
AUTH_TOKEN=

# === Transcription (étape B) ===============================================
# Moteur utilisé pour convertir l'audio en texte.
#   deepgram      — recommandé : bon français, identification native des
#                   locuteurs, fichiers de plusieurs heures acceptés
#   assemblyai    — alternative avec identification native des locuteurs
#   openai        — Whisper hébergé, sans identification des locuteurs,
#                   découpage imposé par la limite de 25 Mo
#   local-whisper — 100 % hors ligne : aucune donnée audio ne quitte la machine
#   test-replay   — RÉSERVÉ AUX TESTS : rejoue une transcription enregistrée
ASR_PROVIDER=deepgram

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

ASSEMBLYAI_API_KEY=

OPENAI_API_KEY=
OPENAI_ASR_MODEL=whisper-1

# Mode local : taille du modèle (tiny, base, small, medium, large-v3).
# « large-v3 » demande environ 4 Go de mémoire et reste lent sans carte
# graphique — comptez une à trois fois la durée de la réunion (voir README).
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Langue attendue. « auto » laisse le moteur la détecter.
ASR_LANGUAGE=fr

# Identification des locuteurs, quand le moteur la propose.
ASR_DIARIZATION=true

# Vocabulaire métier transmis au moteur pour fiabiliser noms propres et
# acronymes. C'est le réglage le plus rentable de ce fichier.
# Exemple : ASR_VOCABULARY=Kubernetes,Grafana,PostgreSQL,SIRH,RGPD
ASR_VOCABULARY=

# === Analyse et rédaction (étapes C et D) ==================================
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Modèles possibles, du plus capable au plus économique. Coût indicatif pour
# une heure de réunion (analyse seule, hors transcription) :
#   claude-opus-5-5    ~0,70 $
#   claude-sonnet-5-5  ~0,30 $
#   claude-haiku-5-5   ~0,02 $
LLM_MODEL=claude-opus-5-5

# Profondeur de raisonnement : low, medium, high, xhigh, max.
# Abaisser cette valeur réduit le coût et la finesse de l'analyse.
LLM_EFFORT=high

# === Audio ==================================================================
# original — conserve l'enregistrement tel quel, sans réencodage (recommandé)
# flac     — réencode en FLAC
# wav      — réencode en WAV 16 bits
# Voir la section « Pourquoi ARCHIVE_FORMAT=original » du README.
ARCHIVE_FORMAT=original

# Durée visée des segments envoyés au moteur, lorsque le découpage est
# nécessaire. Sans effet sur un moteur qui accepte le fichier entier.
CHUNK_TARGET_SECONDS=600

# Taille maximale acceptée pour un enregistrement ou un import, en mégaoctets.
MAX_UPLOAD_MB=2048

# === Confidentialité ========================================================
# Suppression automatique des réunions plus anciennes que N jours, déclenchée
# par un appel à POST /api/maintenance/retention.
# 0 = conservation illimitée (aucune suppression automatique).
RETENTION_DAYS=0
